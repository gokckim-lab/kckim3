# 서버 포트
PORT=3002

# --- Popbill (https://www.popbill.com) ---
# 테스트 계정은 https://test.popbill.com 에서 가입 후 발급받습니다.
POPBILL_LINK_ID=TESTER
POPBILL_SECRET_KEY=여기에_SecretKey_입력
# 테스트: true / 실서비스(과금 발생): false
POPBILL_IS_TEST=true
# 팝빌에 연동회원으로 가입된 우리 회사(공급자)의 사업자등록번호 (하이픈 제외 10자리)
POPBILL_CORP_NUM=0000000000
# 팝빌 담당자 아이디(연동회원 가입 시 설정, 선택)
POPBILL_USER_ID=
# 세금계산서 1건 발행마다 입점업체 지갑에서 차감할 포인트(원)
POPBILL_ISSUE_PRICE=200

# --- Supabase ---
# 프로젝트 설정 > API 에서 확인 (service_role 키는 절대 프론트엔드에 노출하지 말 것)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_입력

# 프론트엔드 개발 서버 주소 (CORS 허용)
FRONTEND_ORIGIN=http://localhost:5173

# --- 나이스페이 (https://www.nicepay.co.kr) : 카드 자동충전 ---
# nicepay-manual 개발자센터(developers.nicepay.co.kr)에서 회원가입 후
# "테스트 상점 개설하기"로 만든 샌드박스의 개발정보 탭에서 확인합니다.
# (토스와 달리 로그인 없이 쓸 수 있는 공용 테스트 키가 없어 직접 가입이 필요합니다)
# 테스트: true / 실서비스(과금 발생): false
NICEPAY_IS_TEST=true
NICEPAY_SECRET_KEY=여기에_시크릿키_입력

# --- 나이스페이 가상계좌 발급 (비인증 결제 API, 카드결제와 별도 서비스/자격 필요) ---
# 가맹점관리자페이지(npg.nicepay.co.kr) > 가맹점정보 > KEY관리 에서 확인.
# 가상계좌 서비스 자체가 계약에 없으면 영업담당자와 먼저 협의해야 함.
NICEPAY_MID=여기에_가맹점아이디_입력
NICEPAY_MERCHANT_KEY=여기에_MerchantKey_입력
# 가상계좌 발급 은행코드. 088=신한은행(기존 무통장입금 계좌와 동일 은행)
NICEPAY_VA_BANK_CODE=088

# --- 고객 문의(불만/문제점) 접수 이메일 발송용 (Resend HTTP API) ---
# Railway 등 클라우드 호스팅은 SMTP 아웃바운드를 막는 경우가 많아 HTTP API 방식을 쓴다.
# resend.com 무료 가입 후 API Keys 메뉴에서 발급 (도메인 인증 없이 바로 사용 가능).
RESEND_API_KEY=여기에_Resend_API_키_입력
# 문의 메일을 받을 주소
CONTACT_TO_EMAIL=여기에_받을_이메일_주소_입력
