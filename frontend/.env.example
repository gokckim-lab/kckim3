# Supabase 프로젝트 설정 > API 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_key_입력

# 팝빌 발행을 처리하는 backend 서버 주소
VITE_BACKEND_URL=http://localhost:3002

# 세금계산서 1건 발행 시 차감되는 포인트 (화면 표시용, 실제 차감 값은 backend/.env의 POPBILL_ISSUE_PRICE)
VITE_ISSUE_PRICE=200

# 토스페이먼츠 카드 자동충전용 클라이언트 키 (backend의 TOSS_SECRET_KEY와 반드시 같은 세트여야 함)
# 아래는 토스 공식 샌드박스의 공개 문서용 테스트 키입니다.
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
